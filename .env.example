# Copy to .env in this project root. Replace all placeholders.
DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/<database>
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
SESSION_HOURS=12
# Tests require a separate disposable PostgreSQL database.
TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/<test_database>
BROWSER_DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/<browser_database>
# Optional server-only provider key; public Himalayas access works without one.
HIMALAYAS_API_KEY=
INGESTION_TIMEOUT_SECONDS=10
INGESTION_MAX_BYTES=3000000
INGESTION_ATTEMPTS=3

# Private resume storage; default ~/.job-search-intelligence/private-resumes.
# Never use a frontend/public/dist directory, public mount or source archive.
# RESUME_STORAGE_ROOT=C:/private-job-search/resumes
RESUME_MAX_BYTES=5242880
RESUME_QUOTA_BYTES=52428800
RESUME_PARSER_TIMEOUT_SECONDS=15
RESUME_MAX_PAGES=50
RESUME_MAX_TEXT_CHARS=120000
RESUME_MAX_SECTIONS=1500

# Phase 7 downstream tasks/outbox; source schedules remain opt-in independently.
AUTOMATION_ENABLED=true
APP_BASE_URL=http://127.0.0.1:5173
# Optional SMTP STARTTLS, disabled unless host AND sender are configured.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=notifications@example.com
